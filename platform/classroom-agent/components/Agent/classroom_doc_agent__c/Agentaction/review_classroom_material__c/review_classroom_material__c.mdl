Agentaction review_classroom_material__c (
   label('Review Classroom Material'),
   active(true),
   api_access(true),
   description('Reviews a Classroom syllabus against the required criteria, annotates the document, and completes the workflow task as Approved or Rejected with a comment. Use this when the user asks to review a syllabus, or from a document workflow task.'),
   hide_in_chat(),
   instructions(@instructions.txt),
   supplemental_instructions(),
   support_chat(true),
   tool_evaluation('AUTO'),
   tool_evaluation_required_tool()
);