RECREATE Aitool drop_student__c (
   label('Drop Student'),
   active(true),
   configuration(),
   description('Drops (withdraws) a student from a course section by setting their Enrolled or Waitlist Course Registration to Dropped. Provide the student''s full name and the section number (e.g., BIO101_F27_AM); both are matched case-insensitively. The tool returns a JSON envelope with responseStatus (SUCCESS or FAILURE), a responseMessage, and on failure a failureReason (e.g., student not found, section not found, not registered, or already completed).'),
   input(@input.txt),
   tool_type('Aitooltype.drop_student__c')
);